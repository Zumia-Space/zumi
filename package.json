  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "@pixiv/three-vrm-animation": "3.5.5",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright-core": "1.60.0",
    "three": "0.186.1",
    "kokoro-js": "^1.2.1",
    "onnxruntime-node": "^1.30.0",
    "phonemizer": "^1.2.1"
  },
  "build": {
    "appId": "space.zumia.desktop",
    "productName": "Zumi",
    "copyright": "Zumia Space",
    "directories": {
      "output": "dist",
      "buildResources": "buildres"
    },
    "files": [
      "src/main/**",
      "vendor/laneboard/**",
      "!vendor/laneboard/scripts/**",
      "vendor/laneboard/scripts/seed.mjs",
      "vendor/laneboard/scripts/migrate-from-legacy.mjs",
      "build/renderer/**",
      "assets/**",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [],
    "beforePack": "scripts/before-pack-release.cjs",
    "afterPack": "scripts/after-pack-default-model.cjs",
    "extraResources": [
      {
        "from": "THIRD_PARTY_LICENSES.md",
        "to": "THIRD_PARTY_LICENSES.md"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "ASSETS-LICENSE.md",
        "to": "ASSETS-LICENSE.md"
      },
      {
        "from": "resources-pinned/room-v2",
        "to": "resources-pinned/room-v2"
      },
      {
        "from": "node_modules/kokoro-js",
        "to": "voice-modules/node_modules/kokoro-js",
        "filter": ["**/*", "!types/**", "!voices/*.bin", "voices/af_heart.bin"]
      },
      {
        "from": "node_modules/phonemizer",
        "to": "voice-modules/node_modules/phonemizer",
        "filter": ["**/*", "!**/*.d.ts", "!**/*.d.ts.map"]
      },
      {
        "from": "node_modules/@huggingface/transformers",
        "to": "voice-modules/node_modules/@huggingface/transformers",
        "filter": ["dist/**", "package.json", "LICENSE"]
      },
      {
        "from": "node_modules/@huggingface/transformers/node_modules/onnxruntime-common",
        "to": "voice-modules/node_modules/@huggingface/transformers/node_modules/onnxruntime-common",
        "filter": ["**/*"]
      },
      {
        "from": "node_modules/@huggingface/transformers/node_modules/onnxruntime-node",
        "to": "voice-modules/node_modules/@huggingface/transformers/node_modules/onnxruntime-node",
        "filter": [
          "dist/**", "lib/**", "package.json",
          "bin/**/win32/x64/**"
        ]
      },
      {
        "from": "vendor/voice-stubs/sharp",
        "to": "voice-modules/node_modules/@huggingface/transformers/node_modules/sharp",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "buildres/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zumi",
      "artifactName": "Zumi-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://zumia.space/updates/windows/x64/"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "release-notes/0.3.7.md"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
