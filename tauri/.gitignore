# T-31 Tauri preview — generated/derived artifacts (never committed)

# Assembled frontend (build/renderer + copied assets + the generated shim).
# Produced by tauri/prep-ui.mjs; the real bundle is what Tauri embeds via `frontendDist: ../ui`.
# A committed placeholder is NOT kept here — build.rs writes a one-line index.html when ui/ is
# empty so `cargo build` works from a clean checkout.
ui/

# Rust build output (kept off C:, lives in this worktree on D:).
target/

# Schemas generated into the crate by tauri-build (capabilities/ACL). Generated, never committed.
src-tauri/gen/schemas/

# allow-<command> permission TOMLs autogenerated by tauri-build from build.rs's AppManifest::commands.
# Regenerated on every build, so they are build output, not source.
src-tauri/permissions/autogenerated/
