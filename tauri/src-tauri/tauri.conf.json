{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zumi Preview",
  "mainBinaryName": "ZumiPreview",
  "version": "../../package.json",
  "identifier": "space.zumia.preview",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Zumi Preview",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#0e1016",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-background-timer-throttling --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' blob: data: ipc: http://ipc.localhost; worker-src 'self' blob:; media-src 'self' blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGQkMxOEFFOUMwNjAzODEKUldTQkF3YWNyaGk4ajZ3VTBTNHIxVDVucTdCT2svem56ZWxIbTdOZEhvd2Y3WWdONkp5ckN3a24K",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/Zumia-Space/zumi/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bundle/": ""
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
