{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ops/attachment.add.json",
  "title": "data for attachment.add",
  "description": "Attach a small file as base64 JSON. Size is capped by the server (BOARD_MAX_ATTACHMENT_BYTES, default 262144 decoded bytes).",
  "x-roles": [
    "owner",
    "coordinator",
    "reporter"
  ],
  "x-target": "taskId",
  "x-revision": "none",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "mime",
    "data_base64"
  ],
  "properties": {
    "name": {
      "$ref": "../common.json#/$defs/fileName"
    },
    "mime": {
      "$ref": "../common.json#/$defs/mime"
    },
    "data_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1400000,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "step_id": {
      "$ref": "../common.json#/$defs/stepId"
    },
    "caption": {
      "type": "string",
      "maxLength": 500
    },
    "visibility": {
      "$ref": "../common.json#/$defs/visibility"
    }
  }
}
