{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ops/roles.reset.json",
  "title": "data for roles.reset",
  "description": "Drop the owner's override of one role slot (code: drop an auto-escalation bump); the default applies again.",
  "x-roles": [
    "owner"
  ],
  "x-target": "taskId",
  "x-revision": "none",
  "x-device": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role"
  ],
  "properties": {
    "role": {
      "enum": [
        "plan",
        "review",
        "scout",
        "code"
      ]
    }
  }
}
