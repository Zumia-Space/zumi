{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.json",
  "title": "Reviewer re-plan of a task (projection, append-only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "task_id",
    "reviewer",
    "body",
    "posted_at",
    "goal_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^plan-[0-9]+(-[0-9]+)?$"
    },
    "legacy_id": {
      "type": "string",
      "maxLength": 64
    },
    "task_id": {
      "$ref": "common.json#/$defs/taskId"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "verdict": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/verdict"
        },
        {
          "const": ""
        }
      ]
    },
    "eta": {
      "type": "string",
      "maxLength": 200
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60000
    },
    "written_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "posted_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "goal_version": {
      "type": "integer",
      "minimum": 0
    },
    "by": {
      "$ref": "common.json#/$defs/actor"
    }
  }
}
