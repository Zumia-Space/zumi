{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owner/confirm.json",
  "title": "POST /api/v1/owner/2fa/confirm: request body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[^<>]*$"
    }
  }
}
