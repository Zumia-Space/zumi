{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inbox-item.json",
  "title": "Inbox item: a report, ask or step proposal submitted by any session",
  "description": "Append-only. Content never changes after submission; the coordinator records a resolution by accepting or dismissing. Open 'ask' items show in the owner-attention block as proposals immediately.",
  "type": "object", "additionalProperties": false,
  "required": ["id", "task_id", "rev", "attribution", "kind", "text"],
  "properties": {
    "id": { "$ref": "common.json#/$defs/recordId" },
    "task_id": { "$ref": "common.json#/$defs/taskId" },
    "rev": { "$ref": "common.json#/$defs/revision" },
    "attribution": { "$ref": "common.json#/$defs/attribution" },
    "kind": { "enum": ["ask", "report", "step"] },
    "text": { "type": "string", "maxLength": 4000 },
    "step_id": { "$ref": "common.json#/$defs/stepId" },
    "state": { "$ref": "common.json#/$defs/stepState" },
    "options": { "$ref": "common.json#/$defs/options" },
    "resolution": {
      "type": "object", "additionalProperties": false, "required": ["action", "at", "by"],
      "properties": {
        "action": { "enum": ["accept", "dismiss"] },
        "note": { "type": "string", "maxLength": 2000 },
        "result_id": { "type": "string", "maxLength": 80 },
        "at": { "$ref": "common.json#/$defs/timestamp" },
        "by": { "$ref": "common.json#/$defs/actor" }
      }
    }
  }
}
