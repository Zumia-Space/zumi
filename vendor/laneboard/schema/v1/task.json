{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.json",
  "title": "Task record (projection)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "rev",
    "visibility",
    "attribution",
    "title",
    "lane",
    "health",
    "status",
    "step_ids"
  ],
  "properties": {
    "id": {
      "$ref": "common.json#/$defs/taskId"
    },
    "dossier_at": {
      "$ref": "common.json#/$defs/timestamp",
      "description": "J-05 dossier gate: when the task's dossier was last brought up to date (dossier.mark, written by the CLI). The supervisor's rule R5 compares it with last_activity_at."
    },
    "rev": {
      "$ref": "common.json#/$defs/revision"
    },
    "visibility": {
      "$ref": "common.json#/$defs/visibility"
    },
    "attribution": {
      "$ref": "common.json#/$defs/attribution"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "lane": {
      "type": "string",
      "maxLength": 64
    },
    "health": {
      "$ref": "common.json#/$defs/health"
    },
    "status": {
      "$ref": "common.json#/$defs/taskStatus"
    },
    "goal": {
      "type": "string",
      "maxLength": 2000
    },
    "now": {
      "type": "string",
      "maxLength": 2000
    },
    "next": {
      "type": "string",
      "maxLength": 2000
    },
    "text_at": {
      "$ref": "common.json#/$defs/timestamp",
      "description": "When now or next last changed (server clock). Absent on tasks written before the stamp existed."
    },
    "context": {
      "type": "string",
      "maxLength": 8000
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "worker": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/worker"
        },
        {
          "type": "null"
        }
      ],
      "description": "Coordinator's default worker. Owner overrides live in routing and always win."
    },
    "loops": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "common.json#/$defs/loop"
      }
    },
    "step_ids": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "common.json#/$defs/stepId"
      }
    },
    "dossier": {
      "type": "string",
      "maxLength": 500,
      "description": "Where the task's full notes live (a path or name, shown as text)."
    },
    "draft_output": {
      "type": "string",
      "maxLength": 2000,
      "description": "Coordinator's draft of the desired output, offered to the owner before a goal lock."
    },
    "draft_outcome": {
      "type": "string",
      "maxLength": 2000,
      "description": "Coordinator's draft of the desired outcome, offered to the owner before a goal lock."
    },
    "architecture": {
      "$ref": "common.json#/$defs/architecture"
    },
    "goal_check": {
      "$ref": "common.json#/$defs/goalCheck"
    },
    "phases": {
      "$ref": "common.json#/$defs/phases"
    },
    "phases_at": {
      "$ref": "common.json#/$defs/timestamp",
      "description": "When the phases last changed, plan or a phase state (server clock). The Now/Next text of a task with phases is stale when its phases moved after it."
    },
    "replans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "by",
          "reason",
          "from",
          "to"
        ],
        "properties": {
          "at": {
            "$ref": "common.json#/$defs/timestamp"
          },
          "by": {
            "type": "string",
            "maxLength": 64
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "from": {
            "type": "array",
            "items": {
              "$ref": "common.json#/$defs/stepId"
            }
          },
          "to": {
            "type": "array",
            "items": {
              "$ref": "common.json#/$defs/stepId"
            }
          },
          "relabeled": {
            "type": "array",
            "description": "Phases kept by id whose label changed: {id, from, to}.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "from", "to"],
              "properties": {
                "id": { "$ref": "common.json#/$defs/stepId" },
                "from": { "type": "string" },
                "to": { "type": "string" }
              }
            }
          }
        }
      },
      "description": "The phase replans, oldest first: who, when, why, phase ids before and after."
    }
  }
}
