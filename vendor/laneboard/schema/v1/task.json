{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.json",
  "title": "Task record (projection)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "rev",
    "visibility",
    "attribution",
    "title",
    "lane",
    "health",
    "status",
    "step_ids"
  ],
  "properties": {
    "id": {
      "$ref": "common.json#/$defs/taskId"
    },
    "rev": {
      "$ref": "common.json#/$defs/revision"
    },
    "visibility": {
      "$ref": "common.json#/$defs/visibility"
    },
    "attribution": {
      "$ref": "common.json#/$defs/attribution"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "lane": {
      "type": "string",
      "maxLength": 64
    },
    "health": {
      "$ref": "common.json#/$defs/health"
    },
    "status": {
      "$ref": "common.json#/$defs/taskStatus"
    },
    "goal": {
      "type": "string",
      "maxLength": 2000
    },
    "now": {
      "type": "string",
      "maxLength": 2000
    },
    "next": {
      "type": "string",
      "maxLength": 2000
    },
    "text_at": {
      "$ref": "common.json#/$defs/timestamp",
      "description": "When now or next last changed (server clock). Absent on tasks written before the stamp existed."
    },
    "context": {
      "type": "string",
      "maxLength": 8000
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "worker": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/worker"
        },
        {
          "type": "null"
        }
      ],
      "description": "Coordinator's default worker. Owner overrides live in routing and always win."
    },
    "loops": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "common.json#/$defs/loop"
      }
    },
    "step_ids": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "common.json#/$defs/stepId"
      }
    },
    "dossier": {
      "type": "string",
      "maxLength": 500,
      "description": "Where the task's full notes live (a path or name, shown as text)."
    },
    "draft_output": {
      "type": "string",
      "maxLength": 2000,
      "description": "Coordinator's draft of the desired output, offered to the owner before a goal lock."
    },
    "draft_outcome": {
      "type": "string",
      "maxLength": 2000,
      "description": "Coordinator's draft of the desired outcome, offered to the owner before a goal lock."
    },
    "architecture": {
      "$ref": "common.json#/$defs/architecture"
    }
  }
}
