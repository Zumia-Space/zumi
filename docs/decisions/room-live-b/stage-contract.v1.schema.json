{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zumi-stage-contract/1",
  "title": "Room live B stage contract v1 (DRAFT, normative once the ADR 2026-11-13-room-live-b is gated). Every object is closed; no free-form string except the guest's anchor names.",
  "$defs": {
    "u8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "u16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "epochMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Host additionally enforces the window [hostNow-2000, hostNow+30000] for startAtEpochMs and atEpochMs"
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/u8"
        },
        "max": {
          "$ref": "#/$defs/u8"
        }
      }
    },
    "emotion": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3,
        4
      ],
      "description": "Wire enum. Mapping to VRM expression presets, identical to chat-brain.js EMOTION_PRESETS (line 69): 0 neutral->relaxed, 1 joy->happy, 2 sad->sad, 3 surprised->surprised, 4 angry->angry. The model has no neutral preset; relaxed is its calm preset."
    },
    "pct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "hostMessage": {
      "description": "Closed oneOf of every host-to-guest message; an item matching none (extra key, string, wrong range) is invalid. Max 128 B each except utterance.schedule (4096 B) and motion (4096 B).",
      "oneOf": [
        {
          "title": "utterance.schedule",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "seq",
            "id",
            "startAtEpochMs",
            "durationMs",
            "emotion",
            "intensity",
            "vis"
          ],
          "properties": {
            "t": {
              "const": 0
            },
            "seq": {
              "$ref": "#/$defs/u32"
            },
            "id": {
              "$ref": "#/$defs/u32"
            },
            "startAtEpochMs": {
              "$ref": "#/$defs/epochMs"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 6000
            },
            "emotion": {
              "$ref": "#/$defs/emotion"
            },
            "intensity": {
              "$ref": "#/$defs/pct"
            },
            "vis": {
              "type": "array",
              "maxItems": 900,
              "items": {
                "$ref": "#/$defs/pct"
              },
              "description": "30 Hz frames x 5 channels (aa ih ou ee oh), flat; length must equal 5*ceil(durationMs*30/1000)"
            }
          }
        },
        {
          "title": "utterance.cancel",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "seq",
            "id",
            "atEpochMs"
          ],
          "properties": {
            "t": {
              "const": 1
            },
            "seq": {
              "$ref": "#/$defs/u32"
            },
            "id": {
              "$ref": "#/$defs/u32"
            },
            "atEpochMs": {
              "$ref": "#/$defs/epochMs"
            }
          }
        },
        {
          "title": "state",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "seq",
            "s"
          ],
          "properties": {
            "t": {
              "const": 2
            },
            "seq": {
              "$ref": "#/$defs/u32"
            },
            "s": {
              "type": "integer",
              "enum": [
                0,
                1,
                2,
                3
              ],
              "description": "0 idle, 1 listening, 2 thinking, 3 speaking"
            }
          }
        },
        {
          "title": "gaze",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "seq",
            "target",
            "anchorIx"
          ],
          "properties": {
            "t": {
              "const": 3
            },
            "seq": {
              "$ref": "#/$defs/u32"
            },
            "target": {
              "type": "integer",
              "enum": [
                0,
                1,
                2,
                3
              ],
              "description": "0 user, 1 away, 2 window, 3 anchor"
            },
            "anchorIx": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            }
          }
        },
        {
          "title": "avatar.rev",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "seq",
            "rev"
          ],
          "properties": {
            "t": {
              "const": 4
            },
            "seq": {
              "$ref": "#/$defs/u32"
            },
            "rev": {
              "$ref": "#/$defs/u32"
            }
          }
        },
        {
          "title": "quality",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "seq",
            "tier"
          ],
          "properties": {
            "t": {
              "const": 5
            },
            "seq": {
              "$ref": "#/$defs/u32"
            },
            "tier": {
              "type": "integer",
              "enum": [
                0,
                1,
                2
              ],
              "description": "0 low, 1 medium, 2 full"
            }
          }
        },
        {
          "title": "motion (contract v2)",
          "description": "T-31-ROOM motion P4/P5: one seated-motion intent and/or composed command as integers (src/renderer/reflex/seated-motion.js encodeMotion; prog[0] = wire version 1). Sent only to a guest that negotiated v >= 2. Max 4096 B.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "seq",
            "id",
            "prog"
          ],
          "properties": {
            "t": {
              "const": 6
            },
            "seq": {
              "$ref": "#/$defs/u32"
            },
            "id": {
              "$ref": "#/$defs/u32"
            },
            "prog": {
              "type": "array",
              "minItems": 8,
              "maxItems": 640,
              "items": {
                "type": "integer",
                "minimum": -32768,
                "maximum": 32767
              }
            }
          }
        }
      ]
    }
  },
  "host_to_guest": {
    "$ref": "#/$defs/hostMessage"
  },
  "poll_response": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "v",
      "seq0",
      "hostNowEpochMs",
      "msgs"
    ],
    "properties": {
      "v": {
        "$ref": "#/$defs/u8"
      },
      "seq0": {
        "$ref": "#/$defs/u32"
      },
      "hostNowEpochMs": {
        "$ref": "#/$defs/epochMs"
      },
      "msgs": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "$ref": "#/$defs/hostMessage"
        }
      }
    }
  },
  "guest_to_host": {
    "stage.poll": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "ack",
        "max"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/version"
        },
        "ack": {
          "$ref": "#/$defs/u32"
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "stage.ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "caps",
        "anchors"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/version"
        },
        "caps": {
          "$ref": "#/$defs/u8",
          "description": "bit0 visemes5, bit1 emotion5, bit2 gaze, bit3 anchors"
        },
        "anchors": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,23}$"
          },
          "description": "The only strings in the contract. Guest to host, once per session, never echoed back."
        }
      }
    },
    "stage.stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fps10",
        "frameP95x10",
        "tier",
        "gaps"
      ],
      "properties": {
        "fps10": {
          "$ref": "#/$defs/u16"
        },
        "frameP95x10": {
          "$ref": "#/$defs/u16"
        },
        "tier": {
          "type": "integer",
          "enum": [
            0,
            1,
            2
          ]
        },
        "gaps": {
          "$ref": "#/$defs/u8"
        }
      }
    }
  },
  "limits": {
    "bodyBytes": {
      "stage.poll": 128,
      "stage.ready": 512,
      "stage.stats": 128
    },
    "hostToGuestPerSecond": {
      "utterance.schedule": 4,
      "utterance.schedule.burst": 8,
      "gaze": 5,
      "state": 4,
      "utterance.cancel": 8,
      "aggregate": 20,
      "motion": 2,
      "motion.burst": 4
    },
    "guestToHostPerSecond": {
      "stage.poll": 8,
      "stage.stats": 1,
      "stage.ready": "once"
    },
    "queue": {
      "messages": 64,
      "bytes": 65536
    },
    "parkTimeoutMs": 25000,
    "lowerBoundLeadMs": 150,
    "refusalsToClose": {
      "count": 20,
      "windowMs": 10000
    }
  },
  "emotionToVrm": {
    "0": "relaxed",
    "1": "happy",
    "2": "sad",
    "3": "surprised",
    "4": "angry"
  }
}
