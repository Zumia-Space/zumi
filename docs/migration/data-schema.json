{
  "schemaVersion": 1,
  "app": "zumi-desktop",
  "appVersion": "0.2.3",
  "base": "f9fafb6",
  "branch": "feat/T-31-tauri",
  "doc": "docs/migration/DATA-SCHEMA.md",
  "notes": "Machine-readable freeze of the app's persisted surface for the Electron -> Tauri migration (P0). Guarded by scripts/check-data-schema.mjs (npm run check:data-schema): it greps src/main/** for settings accesses and userData path joins, and FAILS if it finds a key/file that is not listed here. Add new entries here AND in DATA-SCHEMA.md together. 'settingsKeys' are keys of userData/settings.json. 'userDataFiles' are files/dirs under the resolved userData (or its packaged Zumi-data sibling); 'match' is a JS regex tested against each source-extracted candidate. 'rendererStorage' is app-authored Chromium localStorage (not userData).",
  "settingsKeys": [
    { "key": "model", "type": "string", "setBy": "models:select, models:open-file, wardrobe apply/undo" },
    { "key": "userModelPath", "type": "string", "setBy": "models:open-file, wardrobe apply/undo" },
    { "key": "room", "type": "string", "setBy": "rooms:select, importRoomFile, deleteRoom" },
    { "key": "importedRooms", "type": "array", "setBy": "importRoomFile, deleteRoom" },
    { "key": "roomDefaultPath", "type": "string", "setBy": "operator / roomDefaultPath()" },
    { "key": "roomV2DefaultPath", "type": "string", "setBy": "operator / roomV2DefaultPath()" },
    { "key": "boardPort", "type": "number", "setBy": "startBoard (main.js:560)" },
    { "key": "uiLang", "type": "string", "setBy": "ui:set-lang" },
    { "key": "developerMode", "type": "boolean", "setBy": "ui:set-dev-tools" },
    { "key": "sendClientNamesToAi", "type": "boolean", "setBy": "ui:set-send-client-names" },
    { "key": "requireBoardPin", "type": "boolean", "setBy": "board:setPinRequired, setSecretsOs, disablePin, enablePin" },
    { "key": "aiProvider", "type": "string", "setBy": "pinAiProvider, ai:set-provider" },
    { "key": "aiDefaultsLegacy", "type": "boolean", "setBy": "pinAiProvider" },
    { "key": "aiMode", "type": "string", "setBy": "ai:set-mode (main.js:1062)" },
    { "key": "chatModel", "type": "string", "setBy": "legacy BYOK (read-only writer in wallet path)" },
    { "key": "roleModels", "type": "object", "setBy": "roles:*" },
    { "key": "roleModelsByProvider", "type": "object", "setBy": "ai:set-provider" },
    { "key": "voiceEnabled", "type": "boolean", "setBy": "talk:setVoiceEnabled" },
    { "key": "voiceSpeed", "type": "number", "setBy": "talk:setVoicePrefs" },
    { "key": "voiceVolume", "type": "number", "setBy": "talk:setVoicePrefs" },
    { "key": "thinkSound", "type": "boolean", "setBy": "talk:setThinkSound" },
    { "key": "speakTypedWhenMicOff", "type": "boolean", "setBy": "talk:setSpeakTypedWhenMicOff" },
    { "key": "wardrobeDir", "type": "string", "setBy": "operator" },
    { "key": "wardrobeGate", "type": "object", "setBy": "wardrobe-apply.mjs" },
    { "key": "wardrobeUndo", "type": "object", "setBy": "wardrobe-apply.mjs" },
    { "key": "chair3d", "type": "string", "setBy": "chairs:select (chair3d.mjs:96)" },
    { "key": "sceneRoom", "type": "string", "setBy": "scenes:select (scene-rooms.mjs:100)" },
    { "key": "defaultRoomGoodSha", "type": "string", "setBy": "room-default.mjs:62 until 2026-10-26; LEGACY: room v1 was removed, nothing writes it now (old profiles may still carry it; the first-run import skips it)" },
    { "key": "defaultRoomV2GoodSha", "type": "string", "setBy": "room-default-v2.mjs:76" },
    { "key": "hudStyle", "type": "string", "setBy": "hud:set-prefs (hud-host.mjs:112)" },
    { "key": "hudVoiceMuted", "type": "boolean", "setBy": "hud:set-prefs (hud-host.mjs:112); LEGACY from talk-mode 0.2.5: no longer a HUD pref, folded once into talkLevel (speech-scheduler.mjs migration) and dropped" },
    { "key": "talkLevel", "type": "string", "setBy": "talk:setTalkPrefs (speech-scheduler.mjs setTalkPrefs); talk-mode 0.2.5, 0a11f98" },
    { "key": "soul", "type": "object", "setBy": "soul:save / soul:undo (soul-prefs.js createSoulStore); T-31 0.3.0-alpha.12 -- {name, role, ownerName, style, persona, replyLang, template}; absent = first-run cards not done yet" },
    { "key": "watchLevel", "type": "string", "setBy": "watch:set-level (agent-core.mjs); T-31 0.3.0-alpha.12 -- 'on' (default) | 'off', the read-only board watcher" },
    { "key": "talkVoiceLang", "type": "string", "setBy": "talk:setTalkPrefs; talk-mode 0.2.5" },
    { "key": "talkQuietHours", "type": "object", "setBy": "talk:setTalkPrefs; { on, start, end }; talk-mode 0.2.5" },
    { "key": "talkAsksBreakQuiet", "type": "boolean", "setBy": "talk:setTalkPrefs; talk-mode 0.2.5" },
    { "key": "talkCheckins", "type": "boolean", "setBy": "talk:setTalkPrefs; talk-mode 0.2.5" },
    { "key": "talkMute", "type": "object|null", "setBy": "talk:mute / talk:unmute via setTalkPrefs; { until: epochMs|null }; talk-mode 0.2.5" },
    { "key": "talkLastVersion", "type": "string", "setBy": "talk:setTalkPrefs; talk-mode 0.2.5" },
    { "key": "voiceProviderEn", "type": "string", "setBy": "voice provider pick for English (tts-select.js voiceProviderPrefs); talk-mode 0.2.5" },
    { "key": "voiceProviderVi", "type": "string", "setBy": "voice provider pick for Vietnamese (tts-select.js voiceProviderPrefs); talk-mode 0.2.5" }
  ],
