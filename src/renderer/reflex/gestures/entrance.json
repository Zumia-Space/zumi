{
  "trigger": "entrance",
  "labelVi": "Model change (entrance)",
  "variants": [
    {
      "id": "look-wave", "labelVi": "Faces forward, waves",
      "selftest": { "peakMs": 900 },
      "command": {
        "id": "entrance-look-wave", "priority": 9, "interrupt": true, "mirror": "random",
        "lookAt": [{ "target": "camera", "weight": 1, "inMs": 100, "holdMs": 1700, "outMs": 400 }],
        "reach": [{ "hand": "right", "target": "wave", "inMs": 350, "holdMs": 1300, "outMs": 500, "osc": { "hz": 2.4, "amp": [0.09, 0, 0] } }],
        "hands": [{ "hand": "right", "shape": "open-flat", "weight": 1, "inMs": 350, "holdMs": 1300, "outMs": 500 }],
        "bones": [
          { "bone": "rightHand", "rot": [0, 0, 0], "inMs": 300, "holdMs": 1300, "outMs": 450, "osc": { "hz": 2.4, "amp": [0, 18, 0] } },
          { "bone": "head", "rot": [0, 4, 7], "inMs": 250, "holdMs": 1400, "outMs": 500 }
        ],
        "expressions": [
          { "name": "happy", "weight": 0.85, "inMs": 150, "holdMs": 1600, "outMs": 500 },
          { "name": "aa", "weight": 0.35, "delayMs": 150, "inMs": 80, "holdMs": 250, "outMs": 250 }
        ]
      }
    },
    {
      "id": "bow-wave", "labelVi": "Bows, then waves",
      "selftest": { "peakMs": 480 },
      "command": {
        "id": "entrance-bow-wave", "priority": 9, "interrupt": true, "mirror": "random",
        "bones": [
