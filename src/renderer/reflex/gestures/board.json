        "expressions": [{ "name": "surprised", "weight": 0.6, "inMs": 70, "holdMs": 600, "outMs": 400 }]
      }
    },
    {
      "id": "turn-point", "labelVi": "Turns and points at the board",
      "selftest": { "peakMs": 850 },
      "command": {
        "id": "board-turn-point", "priority": 6, "interrupt": true,
        "bones": [
          { "bone": "head", "rot": [0, -24, 0], "inMs": 200, "holdMs": 1000, "outMs": 500 },
